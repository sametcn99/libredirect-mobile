{
  "name": "@libredirect-mobile/tools",
  "version": "0.1.0",
  "private": true,
  "description": "Bun/TypeScript tooling that generates and validates the LibRedirect Mobile routing manifest.",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "generate": "bun run src/generate-routes.ts",
    "validate": "bun run src/validate-routes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.4",
    "typescript": "^5.7.2"
  }
}
